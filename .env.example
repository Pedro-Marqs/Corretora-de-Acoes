# PostgreSQL
POSTGRES_DB=gestao_acoes
POSTGRES_USER=gestao_acoes
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# Portas publicadas pelo Docker Compose
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Perfil e host para execução local fora do Docker
SPRING_PROFILES_ACTIVE=local
DB_HOST=localhost

# Frontend e cliente HTTP
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
APP_HTTP_CONNECT_TIMEOUT=3s
APP_HTTP_READ_TIMEOUT=5s

# Endpoints externos (opcionais quando os padrões públicos forem adequados)
BRASIL_API_BASE_URL=https://brasilapi.com.br/api
VIA_CEP_BASE_URL=https://viacep.com.br/ws
CVM_BASE_URL=https://dados.cvm.gov.br
BRAPI_BASE_URL=https://brapi.dev/api
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
AWESOME_API_BASE_URL=https://economia.awesomeapi.com.br

# Credenciais externas; preencha somente no arquivo .env local, nunca no Git
BRAPI_TOKEN=
TWELVE_DATA_API_KEY=
AWESOME_API_KEY=

# Provas externas T21 permanecem desabilitadas por padrão
T21_EXTERNAL_SMOKE=false
